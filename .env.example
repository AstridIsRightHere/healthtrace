# 复制为 .env 后填写本机值。此文件只列变量名，不放任何真实值；.env 已被 .gitignore 忽略。
# 开发/测试/生产使用各自独立的值，不共享（29-环境配置说明）。

# --- docker-compose.yml（本地 MySQL 8.4）---
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_PORT=

# --- backend（Spring Boot，DEC-025 Spring Profiles）---
SPRING_PROFILES_ACTIVE=
DB_URL=
DB_USERNAME=
DB_PASSWORD=

# --- 邮箱保护密钥（各 32 字节随机值的 Base64，两把密钥不得相同；各环境独立生成）---
# 生成示例：openssl rand -base64 32
HT_EMAIL_ENCRYPTION_KEY=
HT_EMAIL_INDEX_KEY=

# --- 原图存储（DEC-008）---
# local 仅用于开发/测试；根目录必须是项目与 C 盘之外的绝对路径，缺失时启动失败
HT_STORAGE_TYPE=
HT_STORAGE_LOCAL_ROOT=
