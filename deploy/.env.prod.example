# 复制为 deploy/.env.prod 后填写生产值（chmod 600，只有部署用户可读）。此文件只列变量名，不放任何真实值。
# .env.prod 已被 .gitignore 忽略，绝不提交；生产密钥与开发/测试环境各自独立生成，不共享（29-环境配置说明）。
# 密钥生成：openssl rand -base64 32   （每把密钥单独生成，互不相同）

# --- MySQL 8.4（容器内部使用，不对外暴露端口）---
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=healthtrace
MYSQL_USER=healthtrace
MYSQL_PASSWORD=

# --- 邮箱保护密钥（AES-256-GCM 加密 + HMAC 索引，两把不同）---
HT_EMAIL_ENCRYPTION_KEY=
HT_EMAIL_INDEX_KEY=

# --- 照片文件加密密钥（FileCipher，AES-256-GCM）---
# 丢失或更换会导致已有照片永久无法解密：必须离线备份，且与数据库备份分开保存
HT_STORAGE_ENCRYPTION_KEY=

# --- OCR（百度智能云“医疗检验报告单识别”）---
HT_OCR_ENCRYPTION_KEY=
HT_BAIDU_OCR_API_KEY=
HT_BAIDU_OCR_SECRET_KEY=

# --- 部署参数（可选，均有默认值）---
# 镜像标签，便于回滚：deploy.sh 默认用当前 git 提交短哈希
HT_IMAGE_TAG=
# 证书目录（含 fullchain.pem、privkey.pem），相对 deploy/ 或绝对路径
HT_CERT_DIR=./certs
HT_HTTP_PORT=80
HT_HTTPS_PORT=443
# 覆盖后端 JVM 参数（默认堆 320 MiB，容器上限 512 MiB）
JAVA_OPTS=
