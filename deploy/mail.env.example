# 可选：复制为 deploy/mail.env 启用 SMTP 发信（邮箱验证、找回密码）。不复制则不发信，后端返回 HT-5003。
# mail.env 已被 .gitignore 忽略，绝不提交。注意：文件里只要出现 SPRING_MAIL_HOST 就会启用 SMTP，
# 此时 HT_MAIL_FROM 与 HT_MAIL_LINK_BASE_URL 必填。
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=465
SPRING_MAIL_PROTOCOL=smtps
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
HT_MAIL_FROM=
# 用户访问的站点地址，例如 https://healthtrace.example.com
HT_MAIL_LINK_BASE_URL=
